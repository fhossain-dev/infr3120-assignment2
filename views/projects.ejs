<%- include('partials/header') %>
<%- include('partials/main_nav') %>

<main class="container my-5">

  <section class="mb-5">
    <h1 class="display-5 fw-bold mb-3">
      <i class="fa-solid fa-laptop-code text-primary me-2"></i>
      My Projects
    </h1>

    <p class="lead text-secondary">
      A selection of technical projects and hands-on work
      completed throughout my studies.
    </p>
  </section>

  <section class="row g-4">

    <!-- Project 1: Personal Portfolio Website -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">

        <div class="card-body p-4">
          <div class="mb-3">
            <i class="fa-solid fa-globe fa-2x text-primary"></i>
          </div>

          <h2 class="h5 fw-bold">
            Personal Portfolio Website
          </h2>

          <p>
            Developed a responsive personal portfolio website
            using HTML5 and CSS3. The website includes Home,
            About Me, Projects, and Contact Me pages.
          </p>

          <span class="badge bg-primary">HTML5</span>
          <span class="badge bg-secondary">CSS3</span>
        </div>

        <div class="card-footer bg-white border-0 pb-4 px-4">
          <a
            href="https://github.com/fhossain-dev/infr3120-portfolio"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline-primary"
          >
            <i class="fa-brands fa-github me-2"></i>
            View on GitHub
          </a>
        </div>

      </div>
    </div>

    <!-- Project 2: Smart Parking Gate System -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">

        <div class="card-body p-4">
          <div class="mb-3">
            <i class="fa-solid fa-microchip fa-2x text-primary"></i>
          </div>

          <h2 class="h5 fw-bold">
            Smart Parking Gate System
          </h2>

          <p>
            Designed a smart parking gate system for a
            Computer Architecture project, applying
            digital logic, circuit design, and
            system-design concepts.
          </p>

          <span class="badge bg-primary">Digital Logic</span>
          <span class="badge bg-secondary">Computer Architecture</span>
        </div>

      </div>
    </div>

    <!-- Project 3: MongoDB Database Exercises -->
    <div class="col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm">

        <div class="card-body p-4">
          <div class="mb-3">
            <i class="fa-solid fa-database fa-2x text-primary"></i>
          </div>

          <h2 class="h5 fw-bold">
            MongoDB Database Exercises
          </h2>

          <p>
            Completed practical database exercises using
            MongoDB Atlas, Compass, and MongoDB Shell,
            including inserting, finding, and
            updating documents.
          </p>

          <span class="badge bg-primary">MongoDB</span>
          <span class="badge bg-secondary">Database Management</span>
        </div>

      </div>
    </div>

  </section>

</main>

<%- include('partials/footer') %>